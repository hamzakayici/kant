# Kant Environment Variables

# Seed (yalnızca geliştirme / ilk kurulum)
# SEED_ADMIN_PASSWORD="change-me"
# SEED_USER_PASSWORD="change-me"
# SEED_OWNER_EMAIL="you@example.com"
# SEED_OWNER_PASSWORD="change-me"

# PostgreSQL
DATABASE_URL="postgresql://kant_user:kant_password@127.0.0.1:5433/kant_db?schema=public"

# NextAuth
AUTH_SECRET="change-me-to-a-random-secret"

# OpenCloud (yerel geliştirme veya Docker)
# Docker tam stack: docker compose up -d --build
# Yerel dev: npm run opencloud:up && npm run opencloud:setup
OPENCLOUD_ENABLED=true
# Yerel OpenCloud: https://localhost:9200 (self-signed sertifikayı tarayıcıda kabul edin)
OPENCLOUD_URL="https://localhost:9200"
# Docker içinden erişim için otomatik ayarlanır; tarayıcı linkleri için kullanılır
# OPENCLOUD_PUBLIC_URL="https://localhost:9200"
OPENCLOUD_USERNAME="admin"
OPENCLOUD_PASSWORD="kant_opencloud_dev"
OPENCLOUD_ROOT="Kant"
# opencloud:setup komutu OPENCLOUD_WEBDAV_BASE değerini otomatik yazar
# OPENCLOUD_WEBDAV_BASE="/dav/spaces/storage-users-1%24..."
STORAGE_MODE=opencloud
OPENCLOUD_PUBLIC_SHARES=true
# Yalnızca HTTPS + self-signed sertifika için true
OPENCLOUD_INSECURE=false

# Telegram Sohbet Senkronizasyonu
# BotFather'dan bot oluşturun: https://t.me/BotFather
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_BOT_USERNAME="your_bot_username"
# Webhook güvenliği için rastgele bir secret
TELEGRAM_WEBHOOK_SECRET="change-me-random-secret"
# Telegram süper grup ID (forum açık olmalı)
# TELEGRAM_SUPERGROUP_ID="-1001234567890"
# /chat açıldığında varsayılan konu (ör. 1 = Genel)
# TELEGRAM_DEFAULT_TOPIC_ID="1"
# Kant'tan Telegram'a kendi adınızla göndermek için (https://my.telegram.org/apps)
# TELEGRAM_API_ID="12345678"
# TELEGRAM_API_HASH="your-api-hash"
# Kurulum: npm run telegram:user-session -- kullanici@email.com
# Uygulama URL'si (webhook kaydı için)
# AUTH_URL="https://kant.example.com"
# Geliştirme: AUTH_URL="http://localhost:3000"
# Telegram kart linkleri için dışarıdan erişilebilir HTTPS URL (ngrok / production)
# Mobilde Telegram'dan kart açmak için zorunlu — localhost çalışmaz
# TELEGRAM_PUBLIC_APP_URL="https://abc123.ngrok-free.app"
