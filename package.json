{
  "name": "kant",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzakayici/kant.git"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "graphify:update": "graphify update .",
    "graphify:report": "head -80 graphify-out/GRAPH_REPORT.md",
    "graphify:html": "open graphify-out/graph.html",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:up:db": "docker compose up db -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:push": "prisma db push && prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "npx prisma db seed",
    "opencloud:sync": "tsx --env-file=.env scripts/sync-opencloud.ts",
    "opencloud:up": "docker compose up opencloud opencloud-redirect opencloud-gateway -d",
    "opencloud:down": "docker compose stop opencloud opencloud-redirect opencloud-gateway",
    "opencloud:reset": "docker compose stop opencloud opencloud-redirect opencloud-gateway && docker volume rm -f kant_kant_opencloud_config kant_kant_opencloud_data 2>/dev/null; docker compose up opencloud opencloud-redirect opencloud-gateway -d && tsx --env-file=.env scripts/opencloud-setup.ts",
    "opencloud:setup": "tsx --env-file=.env scripts/opencloud-setup.ts",
    "opencloud:logs": "docker compose logs -f opencloud",
    "telegram:poll": "tsx --env-file=.env scripts/telegram-poll.ts",
    "telegram:user-session": "tsx --env-file=.env scripts/telegram-user-session.ts",
    "telegram:setup": "tsx --env-file=.env scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/swc-darwin-arm64": "^16.2.12",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lightningcss-darwin-arm64": "^1.32.0",
    "lucide-react": "^1.27.0",
    "match-sorter": "^8.3.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
