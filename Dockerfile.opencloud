FROM opencloudeu/opencloud-rolling:7.3.0

# Özel entrypoint: opencloud init + server
COPY docker/opencloud-entrypoint.sh /usr/local/bin/opencloud-entrypoint.sh
RUN chmod +x /usr/local/bin/opencloud-entrypoint.sh

ENV OC_CONFIG_DIR=/etc/opencloud

ENTRYPOINT ["/usr/local/bin/opencloud-entrypoint.sh"]
