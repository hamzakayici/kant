# Kant — Production ortamı
# Kopyala: cp .env.production.example .env.production
# Sunucuda gerçek şifreleri doldurun; .env.production repoya eklenmez.

NODE_ENV=production

# ── Uygulama URL (zorunlu) ───────────────────────────────────────────────────
# Yayın adresi: https://zubi.noktafikir.com
AUTH_URL="https://zubi.noktafikir.com"
NEXTAUTH_URL="https://zubi.noktafikir.com"
NEXT_PUBLIC_APP_URL="https://zubi.noktafikir.com"
TELEGRAM_PUBLIC_APP_URL="https://zubi.noktafikir.com"

# openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_STRONG_SECRET"

# ── Veritabanı (Docker Compose: host adı db) ─────────────────────────────────
DATABASE_URL="postgresql://kant_user:CHANGE_DB_PASSWORD@db:5432/kant_db?schema=public"

# İlk kurulumdan sonra false bırakın
KANT_AUTO_SEED=false

# ── OpenCloud ────────────────────────────────────────────────────────────────
OPENCLOUD_ENABLED=true
# Container içi erişim (değiştirmeyin)
OPENCLOUD_URL="https://opencloud:9200"
# Tarayıcıdan dosya linki gerekiyorsa harici HTTPS adresi (opsiyonel alt alan adı)
# OPENCLOUD_PUBLIC_URL="https://dosya.noktafikir.com"
OPENCLOUD_USERNAME="admin"
OPENCLOUD_PASSWORD="CHANGE_OPENCLOUD_PASSWORD"
OPENCLOUD_ADMIN_PASSWORD="CHANGE_OPENCLOUD_PASSWORD"
OPENCLOUD_ROOT="Kant"
OPENCLOUD_INSECURE=true
OPENCLOUD_PUBLIC_SHARES=true
STORAGE_MODE=opencloud

# ── Telegram (opsiyonel) ─────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""
# TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_SUPERGROUP_ID=""
# TELEGRAM_API_ID=""
# TELEGRAM_API_HASH=""
